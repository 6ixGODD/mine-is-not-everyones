# Enforce LF line endings for text files so cargo fmt, clippy, and CI are
# deterministic across Windows, Linux, and macOS. This overrides a host
# core.autocrlf setting that would otherwise check out CRLF on Windows.

* text=auto eol=lf

# Binary artifacts are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
